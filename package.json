{
  "name": "zurich-maps",
  "version": "0.1.0",
  "private": true,
  "description": "Historical map explorer (OldMapsOnline-style) in the Canton Zürich design system — Cloudflare Workers site",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "preview": "wrangler dev --local",
    "build": "node scripts/validate.mjs",
    "test": "node --test tests/",
    "check": "npm run build && npm test && npm run dry-run",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "harvest": "node scripts/harvest-seed.mjs",
    "harvest:offline": "node scripts/harvest-seed.mjs --offline"
  },
  "devDependencies": {
    "wrangler": "^4.151.1"
  }
}
