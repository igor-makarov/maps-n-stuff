{
  "name": "zurich-maps",
  "version": "0.1.0",
  "private": true,
  "description": "Historical map explorer (OldMapsOnline-style) in the Canton Z\u00fcrich design system \u2014 Cloudflare Workers site",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "wrangler dev",
    "preview": "wrangler dev --local",
    "build": "node scripts/validate.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "check": "npm run build && npm test && npm run dry-run",
    "dry-run": "wrangler deploy --dry-run --outdir dist",
    "harvest": "node scripts/fetch-records.mjs --out public/data",
    "harvest:offline": "node scripts/fetch-records.mjs --out public/data --offline",
    "verify:endpoints": "node scripts/verify-endpoints.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.151.1"
  }
}
