# Cloudflare Workers static assets: response headers for the site.
# https://developers.cloudflare.com/workers/static-assets/headers/
#
# The app is a single-purpose Workers site with no third-party script: the only
# cross-origin images are OpenStreetMap tiles and primary collection images, and
# every fetch goes through the same-origin /api/* Worker proxy.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://www.e-rara.ch https://wmts.geo.admin.ch https://map.geo.admin.ch https://tile.openstreetmap.org https://tile.loc.gov https://www.loc.gov https://gibs.earthdata.nasa.gov https://stacks.stanford.edu https://purl.stanford.edu https://collections.leventhalmap.org https://iiif.digitalcommonwealth.org https://www.doria.fi https://digital.slub-dresden.de https://allmaps.xyz https://prd-tnm.s3.amazonaws.com https://ngmdb.usgs.gov https://www.sciencebase.gov; connect-src 'self'

# Fonts never change under the same file name: cache them hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# App code and styles change during development: short cache, revalidate often.
/app/*
  Cache-Control: public, max-age=300
/styles/*
  Cache-Control: public, max-age=300

# Data files are regenerated by scripts/harvest-seed.mjs: keep them fresh.
/data/*
  Cache-Control: public, max-age=600
